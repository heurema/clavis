{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clavis chart values",
  "description": "Helm validates values against this schema before rendering. Conditions it states badly (mutually exclusive route kinds, fields required only when bootstrap is enabled) are enforced by fail rules in templates/_helpers.tpl instead.",
  "type": "object",
  "additionalProperties": false,
  "required": ["publicURL", "secrets"],
  "properties": {
    "publicURL": {
      "type": "string",
      "description": "The HTTPS origin this installation is reached on, scheme and host only.",
      "pattern": "^https://[^/?#\\s]+/?$"
    },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "name": { "type": "string", "minLength": 1 } },
        "required": ["name"]
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["RollingUpdate", "Recreate"] },
        "rollingUpdate": { "type": "object" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logLevel": { "enum": ["debug", "info", "warn", "error"] },
        "sessionIdleTimeout": {
          "description": "How long an unused session lasts; use renews it. A pattern cannot express the bound, so it is stated here and enforced by a fail rule in templates/_helpers.tpl: at least 5m and at most sessionMaxLifetime, the rule the server accepts.",
          "allOf": [{ "$ref": "#/definitions/duration" }]
        },
        "sessionMaxLifetime": {
          "description": "How long a session lasts after sign-in, however often it is used. Enforced by the same fail rule: at least sessionIdleTimeout and at most 2160h.",
          "allOf": [{ "$ref": "#/definitions/duration" }]
        },
        "dbCheckTimeout": { "$ref": "#/definitions/duration" },
        "shutdownTimeout": { "$ref": "#/definitions/duration" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "encryptionKey"],
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretName"],
          "properties": {
            "secretName": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "encryptionKey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretName"],
          "properties": {
            "secretName": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 },
            "mountPath": { "$ref": "#/definitions/absolutePath" },
            "external": { "type": "boolean" }
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "username": {
          "type": "string",
          "description": "The server's username grammar: 3 to 64 characters, lowercase letters, digits, \".\", \"_\" or \"-\", starting with a letter. Empty is allowed here because bootstrap.enabled false needs no username; the fail rule in templates/_helpers.tpl requires one when it is true.",
          "pattern": "^([a-z][a-z0-9._-]{2,63})?$"
        },
        "password": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": { "type": "string" },
            "key": { "type": "string", "minLength": 1 },
            "mountPath": { "$ref": "#/definitions/absolutePath" },
            "external": { "type": "boolean" }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "annotations": { "$ref": "#/definitions/stringMap" } }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "host": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "pathType": { "enum": ["Exact", "Prefix", "ImplementationSpecific"] },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        },
        "hostnames": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": { "type": "array", "items": { "type": "object" } },
        "egress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "extraEnv": { "type": "array", "items": { "type": "object" } },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" }
  },
  "definitions": {
    "duration": {
      "type": "string",
      "description": "A positive Go duration: one or more number-and-unit pairs using ms, s, m or h, for example 2s, 500ms or 1m30s. At least one pair must be non-zero, so 0s, 0ms and 0h0m are rejected; the server treats a zero timeout as invalid configuration.",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))*(0*[1-9][0-9]*(\\.[0-9]+)?|0+\\.[0-9]*[1-9][0-9]*)(ms|s|m|h)([0-9]+(\\.[0-9]+)?(ms|s|m|h))*$"
    },
    "absolutePath": { "type": "string", "pattern": "^/[^\\s]*[^/\\s]$" },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
