package web

import (
	"github.com/heurema/clavis/internal/platform"
	"github.com/heurema/clavis/internal/web/ui/alert"
	"github.com/heurema/clavis/internal/web/ui/badge"
	"github.com/heurema/clavis/internal/web/ui/button"
	"github.com/heurema/clavis/internal/web/ui/card"
	"github.com/heurema/clavis/internal/web/ui/icon"
)

templ Page() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Clavis — Setup</title>
			<script src="/assets/appearance.js"></script>
			<link rel="stylesheet" href="/assets/app.css"/>
			<script src="/assets/readiness.js" defer></script>
			<script src="/assets/htmx.min.js" defer></script>
		</head>
		<body class="min-h-screen">
			@siteHeader()
			<main class="mx-auto max-w-6xl px-6 py-10 sm:px-10 sm:py-14">
				<div class="mb-8 flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-muted-foreground">
					<span>Workspace</span>
					@icon.ArrowRight(icon.Props{Class: "size-3"})
					<span class="text-foreground">Setup</span>
				</div>
				<div class="mb-9 flex flex-wrap items-start justify-between gap-4">
					<div>
						<h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Environment setup</h1>
						<p class="mt-3 max-w-xl text-base leading-7 text-muted-foreground">A working foundation for controlled access. Check your local services, then explore Clavis from the command line.</p>
					</div>
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "mt-2"}) {
						Local development
					}
				</div>
				<div class="grid items-start gap-6 lg:grid-cols-[1.55fr_1fr]">
					@card.Card(card.Props{Class: "min-w-0 gap-0 overflow-hidden py-0"}) {
						<div class="border-b px-6 py-5">
							<h2 class="font-semibold">Service readiness</h2>
						</div>
						<div class="space-y-6 p-6">
							<div id="readiness" role="status" aria-live="polite" aria-atomic="true">
								@statusContent("checking")
							</div>
							<div class="flex flex-wrap items-center justify-between gap-4 border-t pt-5">
								<span class="text-xs text-muted-foreground">Checks run when you open this page or retry.</span>
								@button.Button(button.Props{
									ID:      "readiness-check",
									Variant: button.VariantSecondary,
									Attributes: templ.Attributes{
										"hx-get":     "/ui/readiness",
										"hx-trigger": "load, click",
										"hx-target":  "#readiness",
										"hx-swap":    "innerHTML settle:0",
										"hx-sync":    "this:replace",
										// The application deadline covers the entire body and UI settlement.
										"hx-config": "timeout:0",
									},
								}) {
									@icon.RefreshCw(icon.Props{Class: "size-4"})
									<span id="readiness-action">Retry</span>
								}
							</div>
							<noscript>JavaScript is required for interactive checks. Use the CLI or <a href="/health/ready" class="underline">JSON readiness endpoint</a>.</noscript>
						</div>
					}
					<div class="min-w-0 space-y-6">
						@card.Card() {
							@card.Content() {
								@icon.SquareTerminal(icon.Props{Class: "mb-4 size-6 text-muted-foreground"})
								<h2 class="font-semibold">Continue in your terminal</h2>
								<p class="mt-2 text-sm leading-6 text-muted-foreground">Run the same readiness check from the project directory. The CLI returns structured results for you and your agents.</p>
								<pre class="mt-5 overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 px-4 py-4 text-sm text-slate-100"><code><span class="select-none text-slate-500" aria-hidden="true">$ </span>./bin/clavis doctor</code></pre>
								<p class="mt-4 text-xs leading-5 text-muted-foreground">Use <code class="text-foreground">./bin/clavis help</code> to see available commands.</p>
							}
						}
						<div class="px-1">
							<h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">A foundation, ready to grow</h2>
							<p class="mt-3 text-sm leading-6 text-muted-foreground">Initial administrator setup is managed by your deployment. Once the environment is ready, sign in with your local account. Permissions, external connections and audit inspection will follow.</p>
							@button.Button(button.Props{Href: "/login", Class: "mt-4"}) {
								Sign in
							}
						</div>
					</div>
				</div>
				@siteFooter()
				for _, state := range []string{"checking", "server-unavailable", "timeout", "unexpected"} {
					<template id={ "readiness-" + state }>
						@statusContent(state)
					</template>
				}
			</main>
		</body>
	</html>
}

templ Readiness(readiness platform.Readiness) {
	switch readiness.State {
		case platform.Ready, platform.DependencyUnavailable, platform.Initializing, platform.SetupRequired, platform.BootstrapFailed, platform.SchemaError:
			@statusContent(string(readiness.State))
		default:
			@statusContent(string(platform.DependencyUnavailable))
	}
}

templ statusContent(state string) {
	{{ v := readinessView(state) }}
	<div data-readiness-state={ state } class="space-y-6">
		@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: v.tone}) {
			{ v.badge }
		}
		@alert.Alert(alert.Props{Role: "presentation", Class: v.tone}) {
			<h3 class="col-start-2 font-medium">{ v.title }</h3>
			@alert.Description(alert.DescriptionProps{Class: "text-current"}) {
				<p>{ v.description }</p>
			}
		}
		<dl class="divide-y">
			<div class="flex items-center justify-between gap-4 pb-5">
				<dt class="flex items-center gap-3 text-sm font-medium">
					@icon.Server(icon.Props{Class: "size-5 shrink-0 text-muted-foreground"})
					Clavis server
				</dt>
				<dd class="text-sm text-muted-foreground">{ v.server }</dd>
			</div>
			<div class="flex items-center justify-between gap-4 pt-5">
				<dt class="flex items-center gap-3 text-sm font-medium">
					@icon.Database(icon.Props{Class: "size-5 shrink-0 text-muted-foreground"})
					Platform database
				</dt>
				<dd class="text-sm text-muted-foreground">{ v.database }</dd>
			</div>
		</dl>
	</div>
}
