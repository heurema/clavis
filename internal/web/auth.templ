package web

import (
	"github.com/heurema/clavis/internal/auth"
	"github.com/heurema/clavis/internal/web/ui/alert"
	"github.com/heurema/clavis/internal/web/ui/badge"
	"github.com/heurema/clavis/internal/web/ui/button"
	"github.com/heurema/clavis/internal/web/ui/card"
	"github.com/heurema/clavis/internal/web/ui/icon"
)

// publicDocument frames every document a signed-out visitor can reach: the head
// with the two embedded assets, a slim top bar with the mark and the appearance
// button, and the main column supplied by the caller.
templ publicDocument(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ "Clavis — " + title }</title>
			<script src="/assets/appearance.js"></script>
			<link rel="stylesheet" href="/assets/app.css"/>
		</head>
		<body class="min-h-screen">
			<header class="flex h-14 items-center border-b bg-card px-6 sm:px-10">
				<a href="/" aria-label="Clavis home" class="flex items-center gap-2 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">
					<span class="flex size-[26px] items-center justify-center rounded-md bg-foreground text-background">
						@icon.KeyRound(icon.Props{Class: "size-[15px]"})
					</span>
					<span class="text-[15px] font-semibold tracking-tight">Clavis</span>
				</a>
				<div class="ml-auto flex items-center">
					@appearanceButton()
				</div>
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

// The appearance control is a plain button: both icons stay in the document and
// the stylesheet shows the one that matches the current appearance, so a
// keyboard user toggles a single control whose state is announced.
templ appearanceButton() {
	<button type="button" data-appearance="true" aria-pressed="false" aria-label="Dark appearance" class="inline-flex size-8 items-center justify-center rounded-md border bg-card text-muted-foreground shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
		@icon.Moon(icon.Props{Class: "size-[15px] dark:hidden"})
		@icon.Sun(icon.Props{Class: "hidden size-[15px] dark:block"})
	</button>
}

// The attribution link travels with the binary, so every public document keeps
// one line pointing at the embedded notices.
templ publicNotices() {
	<footer class="pt-1 text-xs text-muted-foreground">
		<a href="/assets/notices.txt" class="underline underline-offset-4">Third-party notices</a>
	</footer>
}

templ Login(model LoginModel) {
	@publicDocument("Sign in") {
		<div class="mx-auto w-full max-w-sm space-y-5 px-6 pt-24 pb-16">
			<h1 class="text-[22px] font-semibold tracking-tight">Sign in</h1>
			if model.ErrorCode != "" {
				@alert.Alert(alert.Props{ID: "auth-error", Variant: alert.VariantDestructive, Attributes: templ.Attributes{"tabindex": "-1", "autofocus": true}}) {
					@alert.Description() {
						<p>{ authMessage(model.ErrorCode) }</p>
						if model.ErrorCode == auth.RateLimited {
							<p>{ retryMessage(model.RetryAfterSeconds) }</p>
						}
						<p>Your password has been cleared. Enter it again to retry.</p>
					}
				}
			}
			@card.Card(card.Props{Class: "p-5"}) {
				<form action="/login" method="post" class="space-y-4">
					<div class="space-y-1.5">
						<label for="username" class="block text-[13px] font-medium">Username</label>
						<input id="username" name="username" type="text" value={ retainedUsername(model.Username) } required minlength="3" maxlength="64" pattern="[a-z][a-z0-9._\-]{2,63}" autocomplete="username" autocapitalize="none" spellcheck="false" class="h-9 w-full min-w-0 rounded-md border bg-card px-2.5 text-sm shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"/>
					</div>
					<div class="space-y-1.5">
						<label for="password" class="block text-[13px] font-medium">Password</label>
						<input id="password" name="password" type="password" required autocomplete="current-password" class="h-9 w-full min-w-0 rounded-md border bg-card px-2.5 text-sm shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"/>
					</div>
					@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
						Sign in
					}
				</form>
			}
			@publicNotices()
		</div>
	}
}

templ Admin(model AdminModel) {
	@publicDocument("Administration") {
		<div class="mx-auto w-full max-w-6xl space-y-6 px-6 pt-10 pb-16 sm:px-10">
			<h1 class="text-[22px] font-semibold tracking-tight">Administration</h1>
			<p class="text-sm text-muted-foreground">Signed in as</p>
			<p class="break-all text-lg font-semibold">{ model.User.Username }</p>
			<p class="text-sm leading-6 text-muted-foreground">Administrator access. Manage users and connections through the CLI; this page only lists them.</p>
			@userList(model)
			@connectionList(model)
			@grantList(model)
			<form action="/logout" method="post">
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
					Sign out
				}
			</form>
			@publicNotices()
		</div>
	}
}

// The list is read-only: no management forms, no scripts and no per-user links
// are rendered here. Every cell is escaped text from the bounded listing.
templ userList(model AdminModel) {
	<section class="space-y-3">
		<h2 class="text-xl font-semibold tracking-tight">Users</h2>
		if len(model.Users) == 0 {
			<p class="text-sm leading-6 text-muted-foreground">No user accounts are listed.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full border-collapse text-left text-sm">
					<thead>
						<tr class="border-b text-xs uppercase tracking-wide text-muted-foreground">
							<th scope="col" class="py-2 pr-4 font-medium">Username</th>
							<th scope="col" class="py-2 pr-4 font-medium">Role</th>
							<th scope="col" class="py-2 pr-4 font-medium">Status</th>
							<th scope="col" class="py-2 font-medium">Created</th>
						</tr>
					</thead>
					<tbody>
						for _, user := range model.Users {
							<tr class="border-b last:border-0 align-top">
								<th scope="row" class="break-all py-2 pr-4 font-medium">{ user.Username }</th>
								<td class="py-2 pr-4">
									@badge.Badge(badge.Props{Variant: roleVariant(user.Role)}) {
										{ string(user.Role) }
									}
								</td>
								<td class="py-2 pr-4">
									@badge.Badge(badge.Props{Variant: statusVariant(user.Disabled)}) {
										{ statusLabel(user.Disabled) }
									}
								</td>
								<td class="whitespace-nowrap py-2 tabular-nums">{ createdLabel(user.CreatedAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if model.Truncated {
				<p class="text-sm leading-6 text-muted-foreground">{ truncationNotice() }</p>
			}
		}
	</section>
}

// Connections are listed exactly like users: read-only, escaped text and
// badges only. Targets, roles, URLs and credentials are never display data, so
// no cell reads Connection.Target and the model carries no secret at all.
templ connectionList(model AdminModel) {
	<section class="space-y-3">
		<h2 class="text-xl font-semibold tracking-tight">Connections</h2>
		if len(model.Connections) == 0 {
			<p class="text-sm leading-6 text-muted-foreground">No connections are registered.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full border-collapse text-left text-sm">
					<thead>
						<tr class="border-b text-xs uppercase tracking-wide text-muted-foreground">
							<th scope="col" class="py-2 pr-4 font-medium">Name</th>
							<th scope="col" class="py-2 pr-4 font-medium">Title</th>
							<th scope="col" class="py-2 pr-4 font-medium">Provider</th>
							<th scope="col" class="py-2 pr-4 font-medium">Labels</th>
							<th scope="col" class="py-2 pr-4 font-medium">Status</th>
							<th scope="col" class="py-2 font-medium">Last check</th>
						</tr>
					</thead>
					<tbody>
						for _, connection := range model.Connections {
							<tr class="border-b last:border-0 align-top">
								<th scope="row" class="break-all py-2 pr-4 font-medium">{ connection.Name }</th>
								<td class="break-words py-2 pr-4">{ connection.Title }</td>
								<td class="py-2 pr-4">{ string(connection.Provider) }</td>
								<td class="py-2 pr-4">
									if len(connection.Labels) == 0 {
										<span class="text-muted-foreground">None</span>
									} else {
										<span class="flex flex-wrap gap-1">
											for _, pair := range labelPairs(connection.Labels) {
												@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
													{ pair }
												}
											}
										</span>
									}
								</td>
								<td class="py-2 pr-4">
									@badge.Badge(badge.Props{Variant: connectionStatusVariant(connection.Enabled)}) {
										{ connectionStatusLabel(connection.Enabled) }
									}
								</td>
								<td class="py-2">
									if connection.LastCheck == nil {
										<span class="text-muted-foreground">Unchecked</span>
									} else {
										<span class="flex flex-wrap items-center gap-2">
											@badge.Badge(badge.Props{Variant: checkOutcomeVariant(connection.LastCheck.Outcome)}) {
												{ string(connection.LastCheck.Outcome) }
											}
											<span class="whitespace-nowrap tabular-nums">{ createdLabel(connection.LastCheck.CheckedAt) }</span>
										</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if model.ConnectionsTruncated {
				<p class="text-sm leading-6 text-muted-foreground">{ connectionsTruncationNotice() }</p>
			}
		}
	</section>
}

// Grants are the third read-only table: who may use which connection, when
// it was granted and by whom. Every cell is a username, a connection name or
// a time; identifiers never render.
templ grantList(model AdminModel) {
	<section class="space-y-3">
		<h2 class="text-xl font-semibold tracking-tight">Grants</h2>
		if len(model.Grants) == 0 {
			<p class="text-sm leading-6 text-muted-foreground">No grants are recorded.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full border-collapse text-left text-sm">
					<thead>
						<tr class="border-b text-xs uppercase tracking-wide text-muted-foreground">
							<th scope="col" class="py-2 pr-4 font-medium">Username</th>
							<th scope="col" class="py-2 pr-4 font-medium">Connection</th>
							<th scope="col" class="py-2 pr-4 font-medium">Granted</th>
							<th scope="col" class="py-2 font-medium">Granted by</th>
						</tr>
					</thead>
					<tbody>
						for _, grant := range model.Grants {
							<tr class="border-b last:border-0 align-top">
								<th scope="row" class="break-all py-2 pr-4 font-medium">{ grant.User.Name }</th>
								<td class="break-all py-2 pr-4">{ grant.Connection.Name }</td>
								<td class="whitespace-nowrap py-2 pr-4 tabular-nums">{ createdLabel(grant.CreatedAt) }</td>
								<td class="break-all py-2">{ grant.CreatedBy.Name }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if model.GrantsTruncated {
				<p class="text-sm leading-6 text-muted-foreground">{ grantsTruncationNotice() }</p>
			}
		}
	</section>
}

templ AuthError(model AuthErrorModel) {
	@publicDocument("Access unavailable") {
		<div class="mx-auto w-full max-w-sm space-y-5 px-6 pt-24 pb-16">
			<h1 class="text-[22px] font-semibold tracking-tight">Access unavailable</h1>
			@alert.Alert(alert.Props{ID: "auth-error", Variant: alert.VariantDestructive, Attributes: templ.Attributes{"tabindex": "-1", "autofocus": true}}) {
				@alert.Description() {
					if model.RemoteRevocationUnconfirmed {
						<p>You have signed out locally, but remote session revocation could not be confirmed. The session may remain usable elsewhere until it expires or is revoked.</p>
					} else {
						<p>{ authMessage(model.ErrorCode) }</p>
					}
				}
			}
			<div class="flex flex-wrap gap-3">
				@button.Button(button.Props{Href: "/login"}) {
					Sign in
				}
			</div>
			if model.ErrorCode == auth.Forbidden && !model.RemoteRevocationUnconfirmed {
				<form action="/logout" method="post">
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
						Sign out
					}
				</form>
			}
			@publicNotices()
		</div>
	}
}
