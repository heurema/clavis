package web

import (
	"strconv"

	"github.com/heurema/clavis/internal/auth"
	"github.com/heurema/clavis/internal/web/ui/alert"
	"github.com/heurema/clavis/internal/web/ui/badge"
	"github.com/heurema/clavis/internal/web/ui/button"
	"github.com/heurema/clavis/internal/web/ui/card"
	"github.com/heurema/clavis/internal/web/ui/icon"
)

// publicDocument frames every document a signed-out visitor can reach: the head
// with the two embedded assets, a slim top bar with the mark and the appearance
// button, and the main column supplied by the caller.
templ publicDocument(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ "Clavis — " + title }</title>
			<script src="/assets/appearance.js"></script>
			<link rel="stylesheet" href="/assets/app.css"/>
		</head>
		<body class="min-h-screen">
			<header class="flex h-14 items-center border-b bg-card px-6 sm:px-10">
				<a href="/" aria-label="Clavis home" class="flex items-center gap-2 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">
					<span class="flex size-[26px] items-center justify-center rounded-md bg-foreground text-background">
						@icon.KeyRound(icon.Props{Class: "size-[15px]"})
					</span>
					<span class="text-[15px] font-semibold tracking-tight">Clavis</span>
				</a>
				<div class="ml-auto flex items-center">
					@appearanceButton("size-8")
				</div>
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

// The appearance control is a plain button: both icons stay in the document and
// the stylesheet shows the one that matches the current appearance, so a
// keyboard user toggles a single control whose state is announced.
templ appearanceButton(size string) {
	<button type="button" data-appearance="true" aria-pressed="false" aria-label="Dark appearance" class={ "inline-flex items-center justify-center rounded-md border bg-card text-muted-foreground shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring " + size }>
		@icon.Moon(icon.Props{Class: "size-[15px] dark:hidden"})
		@icon.Sun(icon.Props{Class: "hidden size-[15px] dark:block"})
	</button>
}

templ Login(model LoginModel) {
	@publicDocument("Sign in") {
		<div class="mx-auto w-full max-w-sm space-y-5 px-6 pt-24 pb-16">
			<h1 class="text-[22px] font-semibold tracking-tight">Sign in</h1>
			if model.ErrorCode != "" {
				@alert.Alert(alert.Props{ID: "auth-error", Variant: alert.VariantDestructive, Attributes: templ.Attributes{"tabindex": "-1", "autofocus": true}}) {
					@alert.Description() {
						<p>{ authMessage(model.ErrorCode) }</p>
						if model.ErrorCode == auth.RateLimited {
							<p>{ retryMessage(model.RetryAfterSeconds) }</p>
						}
					}
				}
			}
			@card.Card(card.Props{Class: "p-5"}) {
				<form action={ loginAction(model.Action) } method="post" class="space-y-4">
					<div class="space-y-1.5">
						<label for="username" class="block text-[13px] font-medium">Username</label>
						<input id="username" name="username" type="text" value={ retainedUsername(model.Username) } required minlength="3" maxlength="64" pattern="[a-z][a-z0-9._\-]{2,63}" autocomplete="username" autocapitalize="none" spellcheck="false" class="h-9 w-full min-w-0 rounded-md border bg-card px-2.5 text-sm shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"/>
					</div>
					<div class="space-y-1.5">
						<label for="password" class="block text-[13px] font-medium">Password</label>
						<input id="password" name="password" type="password" required autocomplete="current-password" class="h-9 w-full min-w-0 rounded-md border bg-card px-2.5 text-sm shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"/>
					</div>
					@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
						Sign in
					}
				</form>
			}
		</div>
	}
}

// status renders one state as a coloured dot plus the word naming it, so the
// colour reinforces the text and never carries the meaning by itself. Every
// dot class is a literal here: the stylesheet build only keeps classes it can
// read in this file.
templ status(kind statusKind, text string) {
	<span
		if kind == statusBad {
			class="inline-flex items-center gap-2 text-status-bad"
		} else {
			class="inline-flex items-center gap-2"
		}
	>
		switch kind {
			case statusBad:
				<span aria-hidden="true" class="size-[7px] rounded-full bg-status-bad"></span>
			case statusOff:
				<span aria-hidden="true" class="size-[7px] rounded-full bg-status-off"></span>
			default:
				<span aria-hidden="true" class="size-[7px] rounded-full bg-status-ok"></span>
		}
		{ text }
	</span>
}

// navIcon keeps each entry's icon next to the page it belongs to, so the
// sidebar cannot drift from the route it points at.
templ navIcon(page AdminPage) {
	switch page {
		case PageGroups:
			@icon.UsersRound(icon.Props{Class: "size-4 shrink-0"})
		case PageConnections:
			@icon.Link(icon.Props{Class: "size-4 shrink-0"})
		case PageGrants:
			@icon.ShieldCheck(icon.Props{Class: "size-4 shrink-0"})
		default:
			@icon.Users(icon.Props{Class: "size-4 shrink-0"})
	}
}

// navEntry is one sidebar link with its icon, label and bounded count. The
// current page is announced with aria-current and highlighted; both variants
// spell their classes out rather than composing them in Go.
templ navEntry(model AdminModel, page AdminPage, href string, count string) {
	if model.Page == page {
		<a href={ templ.SafeURL(href) } aria-current="page" class="flex h-[34px] items-center gap-2.5 rounded-md bg-secondary px-2.5 text-[13.5px] font-medium text-foreground hover:bg-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
			@navIcon(page)
			{ pageHeading(page) }
			<span class="ml-auto text-xs tabular-nums text-muted-foreground">{ count }</span>
		</a>
	} else {
		<a href={ templ.SafeURL(href) } class="flex h-[34px] items-center gap-2.5 rounded-md px-2.5 text-[13.5px] text-muted-foreground hover:bg-secondary hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
			@navIcon(page)
			{ pageHeading(page) }
			<span class="ml-auto text-xs tabular-nums text-muted-foreground">{ count }</span>
		</a>
	}
}

// adminShell frames every administration page: the sidebar with the mark, the
// appearance button, the four list pages with their bounded counts and the
// signed-in identity with sign-out, and the main column the caller fills. The
// sidebar becomes a top row below the lg breakpoint.
templ adminShell(model AdminModel) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ "Clavis — " + pageHeading(model.Page) }</title>
			<script src="/assets/appearance.js"></script>
			<link rel="stylesheet" href="/assets/app.css"/>
		</head>
		<body class="min-h-screen">
			<div class="flex min-h-screen flex-col lg:flex-row">
				<aside class="flex w-full shrink-0 flex-col gap-1 border-b bg-card px-3 py-4 lg:w-[232px] lg:border-b-0 lg:border-r">
					<div class="flex items-center justify-between px-2 pb-4">
						<a href="/admin/users" aria-label="Clavis home" class="flex items-center gap-2 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">
							<span class="flex size-[26px] items-center justify-center rounded-md bg-foreground text-background">
								@icon.KeyRound(icon.Props{Class: "size-[15px]"})
							</span>
							<span class="text-[15px] font-semibold tracking-tight">Clavis</span>
						</a>
						@appearanceButton("size-7")
					</div>
					<nav aria-label="Administration" class="flex flex-row flex-wrap gap-1 lg:flex-col">
						@navEntry(model, PageUsers, "/admin/users", listCount(len(model.Users), model.Truncated))
						@navEntry(model, PageGroups, "/admin/groups", listCount(len(model.Groups), model.GroupsTruncated))
						@navEntry(model, PageConnections, "/admin/connections", listCount(len(model.Connections), model.ConnectionsTruncated))
						@navEntry(model, PageGrants, "/admin/grants", listCount(len(model.Grants), model.GrantsTruncated))
					</nav>
					<div class="mt-auto flex flex-col gap-0.5 border-t pt-3">
						<div class="flex items-center gap-2.5 px-2.5 py-1.5 text-[13px]">
							<span aria-hidden="true" class="flex size-6 shrink-0 items-center justify-center rounded-full bg-secondary text-[11px] font-semibold">{ initial(model.User.Username) }</span>
							<span class="break-all">{ model.User.Username }</span>
							<span class="text-xs text-muted-foreground">{ "· " + roleLabel(model.User.Role) }</span>
						</div>
						<form action="/logout" method="post">
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, FullWidth: true, Class: "h-[34px] justify-start gap-2.5 px-2.5 text-[13.5px] font-normal text-muted-foreground"}) {
								@icon.LogOut(icon.Props{Class: "size-4"})
								Sign out
							}
						</form>
					</div>
				</aside>
				<main class="flex min-w-0 flex-1 flex-col gap-5 px-6 py-8 sm:px-10">
					<h1 class="text-xl font-semibold tracking-tight">{ pageHeading(model.Page) }</h1>
					{ children... }
				</main>
			</div>
		</body>
	</html>
}

// Admin renders the page the route asked for inside the shared shell. The
// server keeps one view for the four routes, so the page value is the only
// difference between them.
templ Admin(model AdminModel) {
	switch model.Page {
		case PageGroups:
			@adminShell(model) {
				@groupsTable(model)
			}
		case PageConnections:
			@adminShell(model) {
				@connectionsTable(model)
			}
		case PageGrants:
			@adminShell(model) {
				@grantsTable(model)
			}
		default:
			@adminShell(model) {
				@usersTable(model)
			}
	}
}

// The list is read-only: no management forms, no scripts and no per-user links
// are rendered here. Every cell is escaped text from the bounded listing.
templ usersTable(model AdminModel) {
	@card.Card(card.Props{Class: "overflow-hidden py-0 gap-0"}) {
		if len(model.Users) == 0 {
			<p class="px-4 py-6 text-sm text-muted-foreground">No user accounts are listed.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full border-collapse text-left text-[13px]">
					<thead>
						<tr>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Username</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Role</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Status</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Created</th>
						</tr>
					</thead>
					<tbody>
						for _, user := range model.Users {
							<tr class="border-b last:border-0">
								<th scope="row" class="h-[42px] break-words px-4 text-left align-middle font-medium">{ user.Username }</th>
								<td class="h-[42px] whitespace-nowrap px-4 align-middle">{ roleLabel(user.Role) }</td>
								<td class="h-[42px] whitespace-nowrap px-4 align-middle">
									@status(userStatus(user.Disabled))
								</td>
								<td class="h-[42px] whitespace-nowrap px-4 align-middle tabular-nums text-muted-foreground">{ createdLabel(user.CreatedAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
	if model.Truncated {
		<p class="text-sm text-muted-foreground">{ truncationNotice() }</p>
	}
}

// Groups are the second read-only table: who a grant can name beside a user,
// what the group is for, and the two counts that say whether it can be
// deleted. Members are never listed here; a roster is administrator-only data
// the page has no reason to carry.
templ groupsTable(model AdminModel) {
	@card.Card(card.Props{Class: "overflow-hidden py-0 gap-0"}) {
		if len(model.Groups) == 0 {
			<p class="px-4 py-6 text-sm text-muted-foreground">No groups are defined.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full border-collapse text-left text-[13px]">
					<thead>
						<tr>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Name</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Description</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Members</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Grants</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Created</th>
						</tr>
					</thead>
					<tbody>
						for _, group := range model.Groups {
							<tr class="border-b last:border-0">
								<th scope="row" class="h-[42px] break-words px-4 text-left align-middle font-medium">{ group.Name }</th>
								<td class="h-[42px] break-words px-4 align-middle">
									if group.Description == "" {
										<span class="text-muted-foreground">—</span>
									} else {
										{ group.Description }
									}
								</td>
								<td class="h-[42px] whitespace-nowrap px-4 align-middle tabular-nums">{ strconv.Itoa(group.Members) }</td>
								<td class="h-[42px] whitespace-nowrap px-4 align-middle tabular-nums">{ strconv.Itoa(group.Grants) }</td>
								<td class="h-[42px] whitespace-nowrap px-4 align-middle tabular-nums text-muted-foreground">{ createdLabel(group.CreatedAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
	if model.GroupsTruncated {
		<p class="text-sm text-muted-foreground">{ groupsTruncationNotice() }</p>
	}
}

// Connections are listed exactly like users: read-only escaped text. Targets,
// roles, URLs and credentials are never display data, so no cell reads
// Connection.Target and the model carries no secret at all.
templ connectionsTable(model AdminModel) {
	@card.Card(card.Props{Class: "overflow-hidden py-0 gap-0"}) {
		if len(model.Connections) == 0 {
			<p class="px-4 py-6 text-sm text-muted-foreground">No connections are registered.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full border-collapse text-left text-[13px]">
					<thead>
						<tr>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Name</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Title</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Provider</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Labels</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Status</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Last check</th>
						</tr>
					</thead>
					<tbody>
						for _, connection := range model.Connections {
							<tr class="border-b last:border-0">
								<th scope="row" class="h-[42px] break-words px-4 text-left align-middle font-medium">{ connection.Name }</th>
								<td class="h-[42px] break-words px-4 align-middle">{ connection.Title }</td>
								<td class="h-[42px] whitespace-nowrap px-4 align-middle text-muted-foreground">{ string(connection.Provider) }</td>
								<td class="h-[42px] whitespace-nowrap px-4 align-middle">
									if len(connection.Labels) == 0 {
										<span class="text-muted-foreground">—</span>
									} else {
										<span class="flex flex-wrap gap-1.5">
											for _, pair := range labelPairs(connection.Labels) {
												@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "rounded px-1.5 py-0 font-mono text-[11px] font-normal"}) {
													{ pair }
												}
											}
										</span>
									}
								</td>
								<td class="h-[42px] whitespace-nowrap px-4 align-middle">
									@status(connectionStatus(connection.Enabled))
								</td>
								<td class="h-[42px] whitespace-nowrap px-4 align-middle">
									if connection.LastCheck == nil {
										<span class="text-muted-foreground">Not checked</span>
									} else {
										@status(checkStatus(connection.LastCheck.Outcome))
										<span class="ml-2 tabular-nums text-muted-foreground">{ createdLabel(connection.LastCheck.CheckedAt) }</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
	if model.ConnectionsTruncated {
		<p class="text-sm text-muted-foreground">{ connectionsTruncationNotice() }</p>
	}
}

// Grants are the fourth read-only table: which recipient may use which
// connection, when it was granted and by whom. Every cell is a recipient name,
// a connection name or a time; identifiers never render. A group recipient
// carries the kind beside its name, because a user and a group may share one.
templ grantsTable(model AdminModel) {
	@card.Card(card.Props{Class: "overflow-hidden py-0 gap-0"}) {
		if len(model.Grants) == 0 {
			<p class="px-4 py-6 text-sm text-muted-foreground">No grants are recorded.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full border-collapse text-left text-[13px]">
					<thead>
						<tr>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Recipient</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Connection</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Granted</th>
							<th scope="col" class="border-b bg-secondary/50 px-4 py-2 text-[11px] font-medium uppercase tracking-[.04em] text-muted-foreground">Granted by</th>
						</tr>
					</thead>
					<tbody>
						for _, grant := range model.Grants {
							<tr class="border-b last:border-0">
								<th scope="row" class="h-[42px] break-words px-4 text-left align-middle font-medium">
									{ grant.Recipient.Name }
									if grant.Recipient.Kind == auth.RecipientGroup {
										@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-2 rounded px-1.5 py-0 text-[11px] font-normal text-muted-foreground"}) {
											group
										}
									}
								</th>
								<td class="h-[42px] break-words px-4 align-middle">{ grant.Connection.Name }</td>
								<td class="h-[42px] whitespace-nowrap px-4 align-middle tabular-nums text-muted-foreground">{ createdLabel(grant.CreatedAt) }</td>
								<td class="h-[42px] break-words px-4 align-middle text-muted-foreground">{ grant.CreatedBy.Name }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
	if model.GrantsTruncated {
		<p class="text-sm text-muted-foreground">{ grantsTruncationNotice() }</p>
	}
}

// Authorize asks a signed-in person to approve one CLI sign-in. It names the
// account the CLI will act as and the loopback port that asked, so a person
// who did not start a sign-in can notice. There is no Deny: closing the page
// leaves nothing behind.
templ Authorize(model AuthorizeModel) {
	@publicDocument("Approve CLI sign-in") {
		<div class="mx-auto w-full max-w-sm space-y-5 px-6 pt-24 pb-16">
			<h1 class="text-[22px] font-semibold tracking-tight">Approve CLI sign-in</h1>
			@card.Card(card.Props{Class: "p-5"}) {
				<form action="/authorize" method="post" class="space-y-4">
					<input type="hidden" name="port" value={ strconv.Itoa(model.Link.Port) }/>
					<input type="hidden" name="challenge" value={ model.Link.Challenge }/>
					<input type="hidden" name="state" value={ model.Link.State }/>
					<p class="text-sm">
						The Clavis CLI will be signed in as
						<span class="break-all font-semibold">{ model.Username }</span>.
					</p>
					<p class="text-sm text-muted-foreground">
						The request came from a CLI listening on 127.0.0.1 port
						<span class="font-semibold tabular-nums text-foreground">{ strconv.Itoa(model.Link.Port) }</span>.
						Approve only if you just ran clavis login on this computer.
					</p>
					@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
						Approve
					}
				</form>
			}
		</div>
	}
}

// AuthorizeInvalid is the safe 400 document for a link that is not an
// authorization link. It never echoes the submitted parameters.
templ AuthorizeInvalid() {
	@publicDocument("Sign-in link not valid") {
		<div class="mx-auto w-full max-w-sm space-y-5 px-6 pt-24 pb-16">
			<h1 class="text-[22px] font-semibold tracking-tight">Sign-in link not valid</h1>
			@alert.Alert(alert.Props{ID: "auth-error", Variant: alert.VariantDestructive, Attributes: templ.Attributes{"tabindex": "-1", "autofocus": true}}) {
				@alert.Description() {
					<p>This CLI sign-in link is incomplete or malformed. Run clavis login again and open the link it prints.</p>
				}
			}
		</div>
	}
}

templ AuthError(model AuthErrorModel) {
	@publicDocument("Access unavailable") {
		<div class="mx-auto w-full max-w-sm space-y-5 px-6 pt-24 pb-16">
			<h1 class="text-[22px] font-semibold tracking-tight">Access unavailable</h1>
			@alert.Alert(alert.Props{ID: "auth-error", Variant: alert.VariantDestructive, Attributes: templ.Attributes{"tabindex": "-1", "autofocus": true}}) {
				@alert.Description() {
					if model.RemoteRevocationUnconfirmed {
						<p>You have signed out locally, but remote session revocation could not be confirmed. The session may remain usable elsewhere until it expires or is revoked.</p>
					} else {
						<p>{ authMessage(model.ErrorCode) }</p>
					}
				}
			}
			<div class="flex flex-wrap gap-3">
				@button.Button(button.Props{Href: "/login"}) {
					Sign in
				}
			</div>
			if model.ErrorCode == auth.Forbidden && !model.RemoteRevocationUnconfirmed {
				<form action="/logout" method="post">
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
						Sign out
					}
				</form>
			}
		</div>
	}
}
