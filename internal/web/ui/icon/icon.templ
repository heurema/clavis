type Props struct {
	Class string
}

templ svg(props []Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={ p.Class } aria-hidden="true" focusable="false">
		{ children... }
	</svg>
}

templ ArrowRight(props ...Props) {
	@svg(props) {
		<path d="M5 12h14"></path>
		<path d="m12 5 7 7-7 7"></path>
	}
}

templ Database(props ...Props) {
	@svg(props) {
		<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
		<path d="M3 5V19A9 3 0 0 0 21 19V5"></path>
		<path d="M3 12A9 3 0 0 0 21 12"></path>
	}
}

templ KeyRound(props ...Props) {
	@svg(props) {
		<path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path>
		<circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
	}
}

