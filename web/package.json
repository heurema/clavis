{
  "name": "clavis-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "26.8.2",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate-routes": "node scripts/generate-routes.mjs",
    "typecheck": "pnpm generate-routes && tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "lint": "oxlint --type-aware --deny-warnings src vite.config.ts vitest.config.ts playwright.config.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "setup:browser": "playwright install chromium"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@remixicon/react": "4.9.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.33",
    "clsx": "2.1.1",
    "ky": "2.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.36",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
