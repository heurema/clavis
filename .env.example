# Local development only. Copy to .env and keep it out of Git.
# Development commands load .env as data; environment values take precedence.
# UI and API share this listener. There is no frontend server or proxy setting.
CLAVIS_HTTP_ADDR=127.0.0.1:8080
CLAVIS_DATABASE_URL=postgres://clavis:clavis-local-only@127.0.0.1:5432/clavis?sslmode=disable
# Compose only. If changed, update the port in CLAVIS_DATABASE_URL too.
CLAVIS_DB_PORT=5432
CLAVIS_DB_CHECK_TIMEOUT=2s
CLAVIS_SHUTDOWN_TIMEOUT=10s
CLAVIS_LOG_LEVEL=info
# First installation only: uncomment and supply your own personal username and
# absolute owner-only password-file path. No password values belong in .env.
# Initialized installations ignore these inputs; changing them never resets an account.
# CLAVIS_BOOTSTRAP_USERNAME=alice
# CLAVIS_BOOTSTRAP_PASSWORD_FILE=/absolute/path/to/private/initial-password
# Required. Connection credentials are encrypted at rest under this 32-byte key.
# Generate once with owner-only permissions and keep it in your secret manager:
#   umask 077 && openssl rand -hex 32 > /absolute/path/to/private/encryption-key
# Losing the key makes every stored connection credential unrecoverable.
CLAVIS_ENCRYPTION_KEY_FILE=/absolute/path/to/private/encryption-key
# Omit on literal loopback to derive the local origin. For non-loopback, configure
# HTTPS termination and protect direct access to the backend HTTP listener.
# CLAVIS_PUBLIC_URL=https://clavis.example
CLAVIS_SESSION_TTL=8h
# CLI only: export this value or use --server; the CLI does not read .env.
CLAVIS_SERVER_URL=http://127.0.0.1:8080
